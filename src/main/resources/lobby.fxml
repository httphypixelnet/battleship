<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@lobby.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doom.despair.ui.LobbyController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <top>
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="titleImage" fitHeight="123.0" fitWidth="523.0" preserveRatio="true">

            </ImageView>
        </VBox>
    </top>

    <center>
        <HBox spacing="25">

            <!-- Left Panel -->
            <VBox prefWidth="300" spacing="20" styleClass="panel">

                <Label styleClass="section-title" text="Game Actions" />

                <Button fx:id="createGameButton" maxWidth="Infinity" styleClass="primary-button" text="Create Game" />

                <VBox spacing="10">

                    <Label styleClass="section-subtitle" text="Join by Game ID" />

                    <HBox spacing="10">

                        <TextField fx:id="gameIdField" promptText="Enter Game ID" HBox.hgrow="ALWAYS" />

                        <Button fx:id="joinByIdButton" styleClass="secondary-button" text="Join" />

                    </HBox>

                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Label styleClass="info-text" text="Create a game and share the ID with friends." wrapText="true" />

            </VBox>

            <!-- Right Panel -->
            <VBox spacing="10" styleClass="panel" HBox.hgrow="ALWAYS">

                <Label styleClass="section-title" text="Open Games" />

                <TableView fx:id="gamesTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="hostColumn" prefWidth="180" text="Host" />

                        <TableColumn fx:id="idColumn" prefWidth="150" text="Game ID" />

                        <TableColumn fx:id="joinColumn" prefWidth="120" text="Join" />

                    </columns>

                </TableView>

            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="73.0" prefWidth="819.0">
            <Button fx:id="settingsButton" styleClass="icon-button">

                <graphic>
                    <ImageView fx:id="settingsIcon" fitHeight="32" fitWidth="32" preserveRatio="true">

                    </ImageView>
                </graphic>

            </Button>
        </HBox>
    </bottom>

</BorderPane>
